layout mambaid 3.10 pio
export ENV=pio
export TOP_HEAD=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)

# Build and development aliases
export_alias _b "cd $TOP_HEAD && make build; cd -"
export_alias _r "cd $TOP_HEAD && make refresh; cd -"
export_alias _u "cd $TOP_HEAD && make upload; cd -"
export_alias _m "cd $TOP_HEAD && make monitor; cd -"
export_alias _s "cd $TOP_HEAD && make send; cd -"
export_alias _g "cd $TOP_HEAD && make recv; cd -"

# Quick upload without confirmation
export_alias _qu "cd $TOP_HEAD && make upload NO_CONFIRM=1 MONITOR=1; cd -"

# Build and upload
export_alias _bu "cd $TOP_HEAD && make build && make upload MONITOR=1; cd -"
